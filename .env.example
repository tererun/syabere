# =============================================================================
# Discord
# =============================================================================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: if set, slash commands register to this guild only (fast iteration).
# Leave empty for global registration (up to ~1h propagation).
DISCORD_GUILD_ID=

# =============================================================================
# giziroku (see docs/giziroku-api.md)
# =============================================================================
GIZIROKU_WS_URL=ws://localhost:8000
GIZIROKU_API_KEY=
GIZIROKU_LANGUAGE=ja
GIZIROKU_INITIAL_PROMPT=

# =============================================================================
# Google OAuth (per-user Drive linking)
# =============================================================================
# 1. Create an OAuth client in Google Cloud Console:
#      type: "Web application"
#      authorized redirect URI: exactly match GOOGLE_OAUTH_REDIRECT_URI below
# 2. Enable "Google Docs API" and "Google Drive API" in the same project
# 3. Required (minimal) scopes are requested at runtime:
#      - https://www.googleapis.com/auth/documents
#      - https://www.googleapis.com/auth/drive.file   (ONLY files this app creates)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# For local dev, http://127.0.0.1:3000/oauth/callback is the safest choice.
# For prod, terminate TLS at a reverse proxy and put the public HTTPS URL here.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback

# Local callback server bind. Default 127.0.0.1 keeps it off the network.
# Set to 0.0.0.0 ONLY if you are fronting it with a TLS-terminating reverse proxy.
OAUTH_SERVER_HOST=127.0.0.1
OAUTH_SERVER_PORT=3000

# Encrypted token store (AES-256-GCM, file mode 0600)
TOKEN_STORE_PATH=./.data/google-tokens.json

# 32-byte AES-256-GCM key, base64 encoded. Required.
# Generate: bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DO NOT commit this value. Rotating the key invalidates all stored refresh tokens.
TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Docs append throttle
# =============================================================================
# Default 10s → ~6 batchUpdate req/min/user, well under Docs rate limit.
DOCS_FLUSH_INTERVAL_MS=10000

# Optional default Drive folder ID for meeting docs. Users can override
# per-account via the /folder slash command. When unset, docs land in the
# user's Drive root.
#   Example: https://drive.google.com/drive/folders/1AbC_defGhIjKlMnOpQrStUv
#   → GOOGLE_DOCS_FOLDER_ID=1AbC_defGhIjKlMnOpQrStUv
GOOGLE_DOCS_FOLDER_ID=

# =============================================================================
# Gemini (summarization)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
